PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/kafal?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Credentials (hardcoded login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Allowed Frontend URLs (comma separated)
CLIENT_URLS=http://localhost:5173,http://localhost:5174
